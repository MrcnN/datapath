# ========================================================
# Traceforge — Ortam Değişkenleri Şablonu (.env.example)
# ========================================================

# --- SQL Server Bağlantı Parametreleri (Backend) ---
DB_SERVER=localhost
DB_DATABASE=master
DB_USERNAME=
DB_PASSWORD=
DB_TRUSTED_CONNECTION=true
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TIMEOUT=30

# --- Backend API Yapılandırması ---
ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
APP_VERSION=0.1.0

# --- Frontend Yapılandırması ---
VITE_API_URL=http://localhost:8000
